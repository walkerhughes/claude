{
  "mcpServers": {
    "harbor-hub": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${CLAUDE_PLUGIN_ROOT:-.}", "harbor-mcp"],
      "env": {
        "HARBOR_API_KEY": "${HARBOR_API_KEY:-}",
        "HARBOR_MCP_ENABLE_WRITES": "${HARBOR_MCP_ENABLE_WRITES:-}"
      }
    }
  }
}
